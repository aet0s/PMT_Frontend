# TaskFlow Client - Environment Variables Template
# Copy this file to .env and adjust variables to match your deployment environment.

# Central backend API host URL (e.g. http://localhost:5000 in dev, or https://api.yourdomain.com in production)
VITE_API_URL=http://localhost:5000

# Central WebSocket / Socket.io server URL (real-time presence and board sync)
VITE_SERVER_URL=http://localhost:5000

# Backend API proxy target for Vite dev server (/api, /uploads, /socket.io)
VITE_API_TARGET=http://localhost:5000

# Web Push Notifications (Firebase Cloud Messaging - HTTP v1 API)
# If any VITE_FIREBASE_* variable is unset, push notification features remain dormant and hidden.
VITE_FIREBASE_API_KEY="AIzaSyD_3N1gv4OxQXCILW6SEQ-7Ai6iPvjTydg"
VITE_FIREBASE_AUTH_DOMAIN="task-flow-93066.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="task-flow-93066"
VITE_FIREBASE_MESSAGING_SENDER_ID="449456461689"
VITE_FIREBASE_APP_ID="1:449456461689:web:bd80b9e7b4d0b2d66381a8"
VITE_FIREBASE_VAPID_KEY=

